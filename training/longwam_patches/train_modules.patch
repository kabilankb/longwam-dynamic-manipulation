+        # Local option (YAM fine-tune): `train_modules: action` freezes the video expert and
+        # optimizes only the action expert (+ proprio adapter). The action loss never reaches the
+        # video expert anyway (its cache is detached), so this drops the video loss's updates and
+        # ~5B parameters of optimizer state.
+        self.train_modules = str(self.cfg.get("train_modules", "all"))
+        if self.train_modules not in ("all", "action"):
+            raise ValueError(f"`train_modules` must be 'all' or 'action', got {self.train_modules!r}.")
+        if self.train_modules == "action":
+            action_expert = getattr(self.model, "action_expert", None)
+            if action_expert is None:
+                raise ValueError("train_modules=action needs a model with an `action_expert`.")
+            self.model.dit.requires_grad_(False)
+            action_expert.requires_grad_(True)
