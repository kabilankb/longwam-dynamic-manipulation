+def _cross_attention(q, k, v, k_lens):
+    """Text cross-attention: FlashAttention when installed, else masked PyTorch SDPA.
+
+    Local change so Stage-1 inference runs without a FlashAttention build (e.g. on Jetson Thor).
+    q/k/v are [B, L, H, D]; k_lens masks the padded text tokens.
+    """
+    from wan_5b.modules import attention as _attn
+    if _attn.FLASH_ATTN_2_AVAILABLE or _attn.FLASH_ATTN_3_AVAILABLE:
+        return _attn.flash_attention(q, k, v, k_lens=k_lens)
+    mask = None
+    if k_lens is not None:
+        lk = k.shape[1]
+        mask = (torch.arange(lk, device=k.device)[None, :] < k_lens.to(k.device)[:, None])[:, None, None, :]
+    dtype = torch.bfloat16 if q.dtype == torch.float32 else q.dtype
+    out = torch.nn.functional.scaled_dot_product_attention(
+        q.transpose(1, 2).to(dtype), k.transpose(1, 2).to(dtype), v.transpose(1, 2).to(dtype), attn_mask=mask)
+    return out.transpose(1, 2).contiguous().to(q.dtype)
