+def _sdpa_fallback(q, k, v, q_lens, k_lens, softmax_scale, q_scale, causal, window_size, dtype):
+    """flash_attention semantics on torch SDPA: [B, L, N, C] layout, per-sample q/k lengths, GQA."""
+    if tuple(window_size) != (-1, -1):
+        raise NotImplementedError("sliding-window attention needs FlashAttention")
+    out_dtype = q.dtype
+    cast = dtype if q.dtype not in (torch.float16, torch.bfloat16) else q.dtype
+    if q_scale is not None:
+        q = q * q_scale
+    b, lq, nq, _ = q.shape
+    lk, nk = k.shape[1], k.shape[2]
+    qt, kt, vt = (x.transpose(1, 2).to(cast) for x in (q, k, v))
+    if nk != nq:  # grouped-query attention
+        kt = kt.repeat_interleave(nq // nk, dim=1)
+        vt = vt.repeat_interleave(nq // nk, dim=1)
+    mask = None
+    if k_lens is not None or q_lens is not None or causal:
+        mask = torch.ones(b, 1, lq, lk, dtype=torch.bool, device=q.device)
+        if k_lens is not None:
+            mask &= (torch.arange(lk, device=q.device)[None, :] < k_lens.to(q.device)[:, None])[:, None, None, :]
+        if causal:
+            mask &= torch.ones(lq, lk, dtype=torch.bool, device=q.device).tril(lk - lq)[None, None]
+    out = torch.nn.functional.scaled_dot_product_attention(qt, kt, vt, attn_mask=mask, scale=softmax_scale)
+    out = out.transpose(1, 2).contiguous()
+    if q_lens is not None:  # zero padded query rows, as varlen flash attention leaves them unused
+        qmask = (torch.arange(lq, device=q.device)[None, :] < q_lens.to(q.device)[:, None])[:, :, None, None]
+        out = out * qmask
+    return out.to(out_dtype)
+
+
